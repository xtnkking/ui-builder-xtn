{
  "name": "personal-ui-react-starter",
  "private": true,
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run verify:personal-ui",
    "build": "tsc --noEmit && vite build",
    "api:report": "node tools/personal-ui/generate-api-report.mjs --write",
    "api:check": "node tools/personal-ui/generate-api-report.mjs --check",
    "api:compat:report": "node tools/personal-ui/check-api-compatibility.mjs --write",
    "api:compat:check": "node tools/personal-ui/check-api-compatibility.mjs --check",
    "modules:report": "node tools/personal-ui/validate-module-boundaries.mjs --write",
    "modules:check": "node tools/personal-ui/validate-module-boundaries.mjs",
    "test:modules": "node --test tools/personal-ui/validate-module-boundaries.test.mjs",
    "css:report": "node tools/personal-ui/check-css-contract.mjs --write",
    "css:check": "node tools/personal-ui/check-css-contract.mjs",
    "css:dist:check": "node tools/personal-ui/check-css-contract.mjs --dist",
    "test:css": "node --test tools/personal-ui/css-contract-core.test.mjs",
    "support:check": "python ../../scripts/validate_support_matrix.py",
    "test:support": "python ../../scripts/test_support_matrix.py",
    "test:installer": "python ../../scripts/test_installer_contracts.py",
    "test:verifier-paths": "python ../../scripts/test_verifier_path_boundaries.py",
    "test:release": "python ../../scripts/test_release_personal_ui.py && python ../../scripts/test_release_publish_adapter.py",
    "test:hosted-evidence": "python ../../scripts/test_validate_hosted_ci_evidence.py",
    "test:m8": "python ../../scripts/test_run_m8_consumer.py && python ../../scripts/test_m8_evidence.py && python ../../scripts/test_validate_m8_evidence.py && python ../../scripts/test_run_m8_migration.py && python ../../scripts/test_run_m8_quality.py && python ../../scripts/test_run_m8_scenario_quality.py && python ../../scripts/test_assemble_m8_acceptance.py",
    "docs:write": "node tools/personal-ui/generate-component-docs.mjs --write",
    "component-docs:check": "node tools/personal-ui/generate-component-docs.mjs --check",
    "examples:check": "node tools/personal-ui/validate-explorer-cases.mjs",
    "locale:check": "node tools/personal-ui/check-locale-contract.mjs",
    "notices:write": "python ../../scripts/generate_third_party_notices.py --write",
    "notices:check": "python ../../scripts/generate_third_party_notices.py --check",
    "evidence:check": "node tools/personal-ui/validate-test-evidence.mjs",
    "validate:skill": "python ../../scripts/validate_skill.py ../..",
    "docs:check": "npm run api:check && npm run examples:check && npm run evidence:check && npm run locale:check && npm run notices:check && npm run component-docs:check && python ../../scripts/generate_component_coverage.py --check --strict",
    "test:contracts": "npm run verify:personal-ui && npm run modules:check && npm run test:modules && npm run css:check && npm run test:css && npm run support:check && npm run test:support && npm run test:installer && npm run test:verifier-paths && npm run test:release && npm run test:hosted-evidence && npm run test:m8 && python ../../scripts/validate_component_manifest.py && python ../../scripts/test_component_coverage.py && python ../../scripts/test_validate_skill.py && python ../../scripts/test_strict_enforcement.py && npm run test:evidence",
    "test:api-compat": "node --test tools/personal-ui/api-compatibility-core.test.mjs",
    "test:examples": "node --test tools/personal-ui/validate-explorer-cases.test.mjs",
    "test:evidence": "node --test tools/personal-ui/validate-test-evidence.test.mjs",
    "test:types": "tsc --noEmit -p tsconfig.contracts.json",
    "test:components": "vitest run --config vitest.config.ts",
    "test:browser": "playwright test --config playwright.config.ts tests/browser --workers=1",
    "test:a11y": "playwright test --config playwright.config.ts tests/a11y --workers=1",
    "test:visual": "playwright test --config playwright.config.ts tests/visual --project=chromium",
    "release:check": "npm run validate:skill && npm run docs:check && npm run api:compat:check && npm run test:api-compat && npm run test:types && npm run test:contracts && npm run test:components && npm run build && npm run css:dist:check && npm run test:browser && npm run test:a11y && npm run test:visual",
    "release": "python ../../scripts/release_personal_ui.py",
    "preview": "vite preview",
    "verify:personal-ui": "node tools/personal-ui/verify-provenance.mjs --target . --source-root src/personal-ui --manifest component-manifest.json"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@csstools/selector-specificity": "^6.0.0",
    "@playwright/test": "1.55.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^7.1.6",
    "react-hook-form": "^7.88.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.12 <25"
  }
}
